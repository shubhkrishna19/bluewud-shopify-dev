        <div class="bw-flow__stage-head">
          <h3 class="bw-flow__stage-title">Start with the kitchen layout</h3>
          <p class="bw-flow__stage-copy">Choose the layout first. The calculator will adapt the next form around that build direction.</p>
        </div>
        <div class="bw-flow__section">
          <div class="bw-flow__label">Kitchen layout</div>
          <div class="bw-flow__choices" data-flow-group="layout">
            <label class="bw-flow__choice bw-flow__choice--visual is-selected"><input type="radio" name="kitchen_layout" value="L-shape" checked><span class="bw-flow__choice-media"><img src="{{ kitchen_image_l_url }}" alt="L-shape modular kitchen" loading="lazy" width="720" height="540"></span><span class="bw-flow__choice-copy"><span class="bw-flow__choice-title">L-shape</span><span class="bw-flow__choice-note">Balanced for most homes with clean corner-led workflow.</span></span></label>
            <label class="bw-flow__choice bw-flow__choice--visual"><input type="radio" name="kitchen_layout" value="U-shape"><span class="bw-flow__choice-media"><img src="{{ kitchen_image_u_url }}" alt="U-shape modular kitchen" loading="lazy" width="720" height="540"></span><span class="bw-flow__choice-copy"><span class="bw-flow__choice-title">U-shape</span><span class="bw-flow__choice-note">Best when you want stronger storage and deeper prep support.</span></span></label>

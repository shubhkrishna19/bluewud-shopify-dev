<div class="bw-flow" data-bw-kitchen-flow>
  {% unless is_embedded %}
    <section class="bw-planning-rail">
      <div class="bw-planning-rail__items" aria-label="Kitchen planning navigation">
        <a class="bw-planning-rail__link" href="{{ main_url }}">All layouts</a>
        <a class="bw-planning-rail__link" href="{{ l_url }}">L-shape</a>
        <a class="bw-planning-rail__link" href="{{ u_url }}">U-shape</a>
        <a class="bw-planning-rail__link" href="{{ parallel_url }}">Parallel</a>
        <a class="bw-planning-rail__link" href="{{ straight_url }}">Straight</a>
        <a class="bw-planning-rail__link" href="{{ island_url }}">Island</a>
        <a class="bw-planning-rail__link bw-planning-rail__link--accent is-current" href="{{ calculator_url }}">Kitchen Calculator</a>
        <a class="bw-planning-rail__link" href="{{ estimate_url }}">Get Free Estimate</a>
      </div>
    </section>
  {% endunless %}

  <div class="bw-flow__shell">
    <section class="bw-flow__panel">
      <div class="bw-flow__head">
        <span class="bw-flow__eyebrow">Kitchen planning workflow</span>
        <h2 class="bw-flow__title">Modular Kitchen Cost Calculator</h2>
        <p class="bw-flow__copy">Choose the layout, capture the room basics, and keep the brief focused enough for Bluewud to respond well.</p>
      </div>

      <div class="bw-flow__progress">
        <div class="bw-flow__step is-active" data-step-indicator="1"><span class="bw-flow__step-index">01</span><span class="bw-flow__step-label">Layout</span></div>
        <div class="bw-flow__step" data-step-indicator="2"><span class="bw-flow__step-index">02</span><span class="bw-flow__step-label">Basics</span></div>
        <div class="bw-flow__step" data-step-indicator="3"><span class="bw-flow__step-index">03</span><span class="bw-flow__step-label">Materials</span></div>
        <div class="bw-flow__step" data-step-indicator="4"><span class="bw-flow__step-index">04</span><span class="bw-flow__step-label">Accessories</span></div>
        <div class="bw-flow__step" data-step-indicator="5"><span class="bw-flow__step-index">05</span><span class="bw-flow__step-label">Quote</span></div>
      </div>

